# ==========================================
# RESORT MANAGEMENT SYSTEM - ENVIRONMENT
# ==========================================
# DO NOT put real secrets in this file!
# Copy this file to .env and set actual values there.

# Database Configuration
POSTGRES_DB=resort_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-secure-db-password

# JWT Authentication
JWT_SECRET=change-me-to-a-very-long-random-secret-key-at-least-256-bits

# Admin Initializer Configuration (Optional)
ADMIN_EMAIL=admin@paradiseresort.com
ADMIN_PASSWORD=change-me-to-a-secure-admin-password

